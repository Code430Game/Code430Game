{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code430.dev/schemas/vehicles.schema.v0.json",
  "title": "Code 430 vehicle catalogue v0",
  "description": "Vehicles the game can spawn in traffic and the player can drive. The base set ships in game/actors/vehicles/vehicles.v0.json; a pack may ship its own vehicles.v0.json, merged after the base set (an entry with the same id replaces it). Bodies are generated from the body class and dimensions: no art files. Liveries carry tone-mode variants like ads (see content-descriptors.v0.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vehicles"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "default_player": {
      "type": "string",
      "description": "Id of the car the player starts in (base set only)."
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicle"
      }
    }
  },
  "$defs": {
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "body_class",
        "dims",
        "mass_kg",
        "engine_force",
        "brake_force",
        "grip",
        "top_speed_kph",
        "steer_max_rad",
        "seats",
        "colors",
        "spawn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "description": "Invented, never a real make or model."
        },
        "body_class": {
          "enum": [
            "sedan",
            "hatchback",
            "coupe",
            "suv",
            "pickup",
            "van",
            "box_truck",
            "taxi",
            "bus"
          ]
        },
        "dims": {
          "$ref": "#/$defs/dims"
        },
        "mass_kg": {
          "type": "number",
          "minimum": 300,
          "maximum": 40000
        },
        "engine_force": {
          "type": "number",
          "minimum": 0
        },
        "brake_force": {
          "type": "number",
          "minimum": 0
        },
        "grip": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "Wheel friction slip."
        },
        "top_speed_kph": {
          "type": "number",
          "minimum": 10,
          "maximum": 400
        },
        "steer_max_rad": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.2
        },
        "seats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rgb"
          }
        },
        "spawn": {
          "$ref": "#/$defs/spawn"
        },
        "descriptors": {
          "$ref": "#/$defs/descriptors"
        },
        "liveries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variants"
          ],
          "properties": {
            "variants": {
              "type": "object",
              "required": [
                "fallback"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/livery"
              }
            }
          }
        }
      }
    },
    "dims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_m",
        "width_m",
        "height_m",
        "wheelbase_m",
        "track_m",
        "wheel_radius_m",
        "front_overhang_m"
      ],
      "properties": {
        "length_m": {
          "type": "number",
          "minimum": 2.0,
          "maximum": 20.0
        },
        "width_m": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3.0
        },
        "height_m": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 4.5
        },
        "wheelbase_m": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 12.0
        },
        "track_m": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 2.6
        },
        "wheel_radius_m": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.7
        },
        "front_overhang_m": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3.0
        },
        "cabin_start_m": {
          "type": "number",
          "minimum": 0.0,
          "description": "From the front bumper to the foot of the windscreen."
        },
        "roof_length_m": {
          "type": "number",
          "minimum": 0.0
        },
        "bed_length_m": {
          "type": "number",
          "minimum": 0.0,
          "description": "Pickup bed."
        },
        "box_length_m": {
          "type": "number",
          "minimum": 0.0,
          "description": "Box truck cargo box."
        },
        "com_height_m": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "Centre of mass above the ground for handling; default 7% of height_m (kept low on purpose: arcade handling)."
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "roads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "motorway": {
              "type": "number",
              "minimum": 0
            },
            "arterial": {
              "type": "number",
              "minimum": 0
            },
            "local": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "hours": {
          "type": "array",
          "description": "[from, to, factor]: hours on a 24 h clock, wrapping past midnight when from > to.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "livery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rgb"
          }
        },
        "stripe": {
          "enum": [
            "none",
            "check",
            "band"
          ]
        },
        "roof_sign": {
          "type": "string",
          "maxLength": 12
        },
        "descriptors": {
          "$ref": "#/$defs/descriptors"
        }
      }
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "descriptors": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "none",
          "mild",
          "strong",
          "stylized"
        ]
      }
    }
  }
}
