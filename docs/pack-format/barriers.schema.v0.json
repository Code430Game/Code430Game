{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code430.dev/schemas/barriers.schema.v0.json",
  "title": "Code 430 barriers v0",
  "description": "Optional file in a map pack. Wall base lines the game extrudes: bridge parapets, median barriers, guardrails, sound walls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units", "barriers"],
  "properties": {
    "schema_version": {"const": 0},
    "units": {"type": "string"},
    "barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "height_m", "edge_id", "points"],
        "properties": {
          "id": {"type": "string", "pattern": "^b([0-9]+|:[a-z]+:.+:[0-9]+)$", "description": "b:<kind>:<edge id>:<run number on that edge> (older packs: b<n>)"},
          "kind": {"enum": ["parapet", "median", "guardrail", "soundwall", "curb", "roadblock"]},
          "height_m": {"type": "number", "exclusiveMinimum": 0},
          "edge_id": {"type": "string"},
          "border_side": {"description": "A roadblock where the district border cut the road (add-district-stitching): the side it stands on. The game drops it when the neighbouring district is loaded and the crossing joins.", "enum": ["west", "east", "north", "south"]},
          "points": {"type": "array", "minItems": 2, "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}
        }
      }
    }
  }
}
