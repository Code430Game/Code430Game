{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code430.dev/schemas/road_graph.schema.v0.json",
  "title": "Code 430 road graph v0",
  "description": "Output of tools/osm_import. Positions are local metres: x east, y up, z south, relative to meta.origin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nodes", "edges", "pedestrian_ways"],
  "$defs": {
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "polyline": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2},
    "node_id": {"type": "string", "pattern": "^[ncb][0-9]+$", "description": "n: an OSM node, c: a merged junction, b: a dead end on the district border (add-district-stitching)."},
    "road_class": {
      "enum": ["motorway", "motorway_link", "trunk", "trunk_link", "primary", "primary_link", "secondary", "secondary_link", "tertiary", "tertiary_link", "unclassified", "residential", "living_street", "service", "parking"]
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generator", "config", "units", "origin", "bbox", "elevation", "sources", "attribution", "license", "notes"],
      "properties": {
        "schema_version": {"const": 0},
        "generator": {"type": "string"},
        "config": {"type": "string"},
        "units": {"type": "string"},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "easting", "northing", "lat", "lon"],
          "properties": {
            "crs": {"type": "string"},
            "easting": {"type": "number"},
            "northing": {"type": "number"},
            "lat": {"type": "number"},
            "lon": {"type": "number"}
          }
        },
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "elevation": {"type": ["object", "null"]},
        "sources": {"type": "array", "items": {"type": "object"}, "minItems": 1},
        "attribution": {"type": "array", "items": {"type": "string"}, "contains": {"const": "© OpenStreetMap contributors"}},
        "license": {"const": "ODbL-1.0"},
        "notes": {"type": "object"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position", "ground_y", "osm_node_ids", "junction_type"],
        "properties": {
          "id": {"$ref": "#/$defs/node_id"},
          "position": {"$ref": "#/$defs/point"},
          "ground_y": {"type": "number"},
          "osm_node_ids": {"type": "array", "items": {"type": "integer"}, "description": "The OSM nodes merged into this one; empty for a node on the district border (b...), where the importer cut a road."},
          "junction_type": {"enum": ["junction", "pass_through", "dead_end", "fork", "merge"]},
          "control": {"enum": ["none", "signals", "stop", "give_way"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "polyline", "class", "lanes_forward", "lanes_backward", "oneway", "speed_kph", "width_m", "layer", "bridge", "tunnel", "name", "osm_way_id", "defaulted_fields", "access", "length_m"],
        "properties": {
          "id": {"type": "string", "pattern": "^w[0-9]+\\.[0-9]+(b[0-9]+)?$", "description": "w<way>.<segment>; bN: piece N of an edge the district border cut in several"},
          "from": {"$ref": "#/$defs/node_id"},
          "to": {"$ref": "#/$defs/node_id"},
          "polyline": {"$ref": "#/$defs/polyline"},
          "class": {"$ref": "#/$defs/road_class"},
          "lanes_forward": {"type": "integer", "minimum": 1},
          "bus": {"enum": ["", "only", "lane"]},
          "bus_lane": {"type": "integer", "minimum": -1},
          "shoulder_left_m": {"type": "number", "minimum": 0},
          "shoulder_right_m": {"type": "number", "minimum": 0},
          "lanes_backward": {"type": "integer", "minimum": 0},
          "oneway": {"type": "boolean"},
          "speed_kph": {"type": "integer", "minimum": 1},
          "width_m": {"type": "number", "exclusiveMinimum": 0},
          "layer": {"type": "integer"},
          "bridge": {"type": "boolean"},
          "tunnel": {"type": "boolean"},
          "name": {"type": ["string", "null"]},
          "osm_way_id": {"type": "integer"},
          "defaulted_fields": {"type": "array", "items": {"enum": ["lanes", "width", "speed_kph", "oneway", "bridge"]}},
          "access": {"type": ["string", "null"]},
          "length_m": {"type": "number", "minimum": 0},
          "control_to": {"enum": ["none", "signals", "stop"]},
          "control_from": {"enum": ["none", "signals", "stop"]}
        }
      }
    },
    "bus_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position", "edge"],
        "properties": {
          "id": {"type": "string"},
          "position": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "edge": {"type": "string"}
        }
      }
    },
    "gores": {
      "description": "Optional (add-road-shoulders 1.4). Paved gores: strips down the middle of the gap where a ramp runs beside its road the same way, with the half-width at each point. The game draws them as asphalt; the terrain is flat under them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "points", "half_m"],
        "properties": {
          "id": {"type": "string"},
          "points": {"type": "array", "minItems": 2, "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}},
          "half_m": {"type": "array", "items": {"type": "number", "minimum": 0}}
        }
      }
    },
    "pedestrian_ways": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "polyline", "class", "kind", "width_m", "osm_way_id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^p[0-9]+(\\.[0-9]+)?(b[0-9]+)?$"},
          "polyline": {"$ref": "#/$defs/polyline"},
          "class": {"type": "string"},
          "kind": {"enum": ["sidewalk", "crossing", "footway", "path", "steps", "cycleway", "pedestrian", "track", "living_street"]},
          "width_m": {"type": "number", "exclusiveMinimum": 0},
          "covered": {"type": "boolean"},
          "profile": {"enum": ["tunnel", "trench"]},
          "top": {"type": "array", "items": {"type": "number"}},
          "osm_way_id": {"type": "integer"},
          "name": {"type": ["string", "null"]}
        }
      }
    }
  }
}
