{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code430.dev/schemas/buildings.schema.v0.json",
  "title": "Code 430 building footprints v0",
  "description": "Optional file in a map pack. Footprint rings (outer first, then holes) with a height and ground height, plus pre-triangulated roof, in local metres.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units", "buildings"],
  "properties": {
    "schema_version": {"const": 0},
    "units": {"type": "string"},
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "height_m", "ground_y", "rings", "roof_vertices", "roof_triangles", "osm_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[wr][0-9]+\\.[0-9]+$"},
          "kind": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "height_m": {"type": "number", "exclusiveMinimum": 0},
          "ground_y": {"type": "number"},
          "rings": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}},
          "roof_vertices": {"description": "Empty when the footprint has one ring: the roof vertices are then rings[0].", "type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
          "roof_triangles": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0}},
          "osm_id": {"type": "integer"},
          "material": {"type": "string"},
          "colour": {"type": "string"},
          "roof_shape": {"type": "string"},
          "roof_levels": {"type": "number", "minimum": 0},
          "levels": {"type": "number", "minimum": 0},
          "shopfront": {"type": "boolean"},
          "house": {
            "description": "Set on house footprints only: the type to build, the outer-ring edge the front door faces (rings[0][i] to rings[0][i+1]), the door point, the distance from that wall to the street's edge (null with no street in reach), the street's road edge id and the edges shared with a neighbour (party walls).",
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "storeys", "front_edge", "door", "setback_m", "street", "party_walls"],
            "properties": {
              "type": {"enum": ["detached", "cottage", "bungalow", "semi", "terrace"]},
              "storeys": {"type": "number", "exclusiveMinimum": 0},
              "front_edge": {"type": "integer", "minimum": 0},
              "door": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "setback_m": {"type": ["number", "null"], "minimum": 0},
              "street": {"type": ["string", "null"]},
              "party_walls": {"type": "array", "items": {"type": "integer", "minimum": 0}}
            }
          }
        }
      }
    }
  }
}
