{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code430.dev/schemas/character-presets.schema.v1.json",
  "title": "Code 430 character presets v1",
  "description": "Named starting characters a character pack offers in the creator, listed under the player's own saved presets. Colour fields are indices into the pack's palettes; the other fields index the built-in style lists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presets"],
  "properties": {
    "schema_version": {"const": 1},
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profile"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 32},
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skin", "hair", "hair_colour", "top", "bottom", "shoes", "hat", "beard", "glasses", "jacket", "jacket_colour", "height", "build"],
            "properties": {
              "skin": {"type": "integer", "minimum": 0},
              "hair": {"type": "integer", "minimum": 0},
              "hair_colour": {"type": "integer", "minimum": 0},
              "top": {"type": "integer", "minimum": 0},
              "bottom": {"type": "integer", "minimum": 0},
              "shoes": {"type": "integer", "minimum": 0},
              "hat": {"type": "integer", "minimum": 0},
              "beard": {"type": "integer", "minimum": 0},
              "glasses": {"type": "integer", "minimum": 0},
              "jacket": {"type": "integer", "minimum": 0},
              "jacket_colour": {"type": "integer", "minimum": 0},
              "height": {"type": "number", "minimum": 0.9, "maximum": 1.1},
              "build": {"type": "number", "minimum": 0.85, "maximum": 1.2}
            }
          },
          "descriptors": {
            "type": "object",
            "additionalProperties": {"enum": ["none", "mild", "strong", "stylized"]}
          }
        }
      }
    }
  }
}
