; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Code 430"
config/description="Open-world crime game framework on real city roads. Codename Code 430."
run/main_scene="res://scenes/play_testbed.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Settings="*res://core/settings/settings.gd"
Players="*res://core/players.gd"
Session="*res://core/net/session.gd"
ContentMode="*res://core/content/content_mode.gd"
DebugOverlay="*res://core/debug/debug_overlay.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"

