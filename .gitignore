# OS
.DS_Store

# Kickoff archive (contents are unpacked into the repo)
streetlevel-kickoff.zip

# Godot
game/.godot/
# Build stamp written by scripts/stamp-build.sh before an export
game/build_info.json
game/export/
game/android/
*.tmp

# Exports / builds (repo-root build/ only; game/world/build/ holds the pack builder scripts)
/build/
dist/
*.pck
!packs/**/*.pck

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OSM / DEM download caches (never commit raw extracts)
tools/**/.cache/
*.osm
*.osm.pbf
*.osm.bz2
*.tif
*.tiff
*.hgt

# Editors
.idea/
.vscode/
*.swp

# gdUnit4 reports
game/reports/

# OSM import download cache
tools/osm_import/.cache/

# Built map pack chunks (generated by the Godot pack builder)
packs/*/chunks/

# secrets
.env
**/.env
game/log/

# Report relay: pywrangler vendoring and wrangler state
tools/report_relay/src/vendor/
tools/report_relay/.wrangler/
tools/report_relay/python_modules/
tools/report_relay/pylock.toml
tools/report_relay/.venv-workers/

# Claude Code agent worktrees
.claude/worktrees/
